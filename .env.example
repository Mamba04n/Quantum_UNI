APP_NAME="Quantum UNI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
APP_TIMEZONE=America/Managua
STOREFRONT_CSS_VERSION=1.0.3

# Tasas de respaldo para cotizaciones de proveedor (1 unidad de moneda = C$).
# Se usan si el proveedor de tasas no esta disponible.
EXCHANGE_RATE_MANUAL_USD_NIO=
EXCHANGE_RATE_MANUAL_USD_NIO_DATE=
EXCHANGE_RATE_MANUAL_EUR_NIO=
EXCHANGE_RATE_MANUAL_EUR_NIO_DATE=
EXCHANGE_RATE_MANUAL_INR_NIO=
EXCHANGE_RATE_MANUAL_INR_NIO_DATE=
EXCHANGE_RATE_MAX_AGE_DAYS=3
EXCHANGE_RATE_API_IS_OFFICIAL=false
EXCHANGE_RATE_BASE_PATH=base
EXCHANGE_RATE_EXPECTED_BASE=USD

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quantum_uni
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=-06:00

BROADCAST_DRIVER=log
CACHE_DRIVER=file
TRUSTED_PROXIES=
PASSWORD_CHECK_COMPROMISED=false
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
FINANCE_API_TOKEN_TTL_DAYS=1
SANCTUM_EXPIRATION_MINUTES=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@quantum.local"
MAIL_FROM_NAME="${APP_NAME}"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Public quote drawer: catalogue prices follow the ERP base currency.
STOREFRONT_CATALOG_CURRENCY=NIO
STOREFRONT_FREE_SHIPPING_THRESHOLD_USD=250.00

QUANTUM_UNI_ADMIN_EMAIL=admin@quantum-uni.test
QUANTUM_UNI_ADMIN_PASSWORD=
