import { expect, test } from '@playwright/test';
import { loginAs } from './helpers/auth';

const adminEmail = process.env.E2E_ADMIN_EMAIL ?? 'admin@quantum.test';

test.describe('ERP visual smoke', () => {
  test('admin can login and open the main dashboard', async ({ page }, testInfo) => {
    await loginAs(page, adminEmail);
    await page.goto('/dashboard');
    await expect(page).toHaveURL(/\/dashboard/);
    await expect(page.locator('body')).not.toContainText('Server Error');
    await expect(page.locator('body')).not.toContainText('SQLSTATE');
    await testInfo.attach('dashboard', {
      body: await page.screenshot({ fullPage: true }),
      contentType: 'image/png',
    });
  });

  test('commercial manager opens every phase without server errors', async ({ page }, testInfo) => {
    await loginAs(page, adminEmail);

    for (const phase of ['request', 'bid', 'offer', 'approval']) {
      await page.goto(`/sales/quotations/manage/${phase}`);
      await page.waitForLoadState('networkidle');
      await expect(page.locator('body')).not.toContainText('Server Error');
      await expect(page.locator('body')).not.toContainText('SQLSTATE');
      await expect(page.locator('body')).toContainText('Gestor Comercial');
      await testInfo.attach(`commercial-${phase}`, {
        body: await page.screenshot({ fullPage: true }),
        contentType: 'image/png',
      });
    }
  });

  test('admin approvals inbox opens without server errors', async ({ page }, testInfo) => {
    await loginAs(page, adminEmail);
    await page.goto('/admin/approvals');
    await page.waitForLoadState('networkidle');
    await expect(page.locator('body')).not.toContainText('Server Error');
    await expect(page.locator('body')).not.toContainText('SQLSTATE');
    await expect(page.locator('body')).toContainText(/Aprobaciones|aprobaciones/i);
    await testInfo.attach('admin-approvals', {
      body: await page.screenshot({ fullPage: true }),
      contentType: 'image/png',
    });
  });

  test('key ERP modules open as admin', async ({ page }, testInfo) => {
    await loginAs(page, adminEmail);

    const pages = [
      ['/sales/tracker', 'tracker'],
      ['/admin/kardex', 'kardex'],
      ['/admin/proveedores', 'suppliers'],
      ['/inventory/products', 'products'],
      ['/finance/cxc', 'finance-cxc'],
      ['/warehouse/incoming-orders', 'incoming-orders'],
    ] as const;

    for (const [url, name] of pages) {
      await page.goto(url);
      await page.waitForLoadState('networkidle');
      await expect(page.locator('body')).not.toContainText('Server Error');
      await expect(page.locator('body')).not.toContainText('SQLSTATE');
      await testInfo.attach(name, {
        body: await page.screenshot({ fullPage: true }),
        contentType: 'image/png',
      });
    }
  });
});
